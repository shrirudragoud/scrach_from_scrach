{
  "name": "codeblocks",
  "private": true,
  "version": "0.2.0",
  "description": "Kid-friendly code → block flowchart for the web IDE (core, runtime, Konva renderer, React glue).",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:assets": "npm run build:worker -w @codeblocks/runtime",
    "corpus": "node --experimental-strip-types packages/core/scripts/corpus.ts",
    "dev": "npm run dev -w web",
    "e2e": "npm run e2e -w web"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^5.0.4",
    "@types/node": "^22.0.0"
  }
}

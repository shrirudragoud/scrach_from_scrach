{
  "name": "@codeblocks/runtime",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Worker, analyzer client, controller, Zustand slice and Monaco binding for the block view.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./monaco": "./src/monaco.ts",
    "./node": "./src/node.ts"
  },
  "bin": {
    "codeblocks-assets": "./scripts/copy-assets.mjs"
  },
  "scripts": {

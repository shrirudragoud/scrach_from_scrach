    "build:worker": "node scripts/build-worker.mjs"
  },
  "dependencies": {
    "@codeblocks/core": "*",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.22.6"
  },
  "peerDependencies": {
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "zustand": "^5.0.0"
  }
}
